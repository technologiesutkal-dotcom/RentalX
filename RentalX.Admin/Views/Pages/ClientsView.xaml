<UserControl x:Class="RentalX.Admin.Views.Pages.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0,0,14,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,8" Foreground="#64748B" FontSize="12" TextWrapping="Wrap"
                           Text="Login ID and Password are always shown for Super Admin. Use Re-activate after Deactivate so the client can login again."/>
                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding LoadCommand}"/>
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search company, contact, email, phone, login"/>
                </DockPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderThickness="0" RowHeight="40" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="*"/>
                        <DataGridTextColumn Header="Login ID" Binding="{Binding PortalUsername}" Width="120"/>
                        <DataGridTextColumn Header="Password" Binding="{Binding PortalPassword}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource SectionCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="Client details" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Deactivate" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                                    Command="{Binding DeactivateCommand}"/>
                            <Button Content="Re-activate" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    Command="{Binding ReactivateCommand}"
                                    ToolTip="Restore Active + license + login (password RxShop@2026)"/>
                            <Button Content="Edit" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Command="{Binding EditSelectedCommand}"/>
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                                    IsEnabled="{Binding IsEditing}"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#0F766E" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Always-visible credentials for Super Admin -->
                    <Border Background="#ECFDF5" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Client login (always visible to Super Admin)" FontWeight="Bold" Foreground="#115E59" Margin="0,0,0,8"/>
                            <TextBlock FontSize="13" Foreground="#0F172A" LineHeight="22">
                                <Run Text="Login ID: "/><Run Text="{Binding PortalUsername}" FontWeight="Bold"/>
                                <LineBreak/>
                                <Run Text="Password: "/><Run Text="{Binding PortalPassword}" FontWeight="Bold"/>
                            </TextBlock>
                            <Button Content="Copy Login ID &amp; Password" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding CopyCredentialsCommand}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Company name *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditing}" Margin="0,0,0,10"/>

                    <TextBlock Text="Contact name *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditing}" Margin="0,0,0,10"/>

                    <TextBlock Text="Email *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditing}" Margin="0,0,0,10"/>

                    <TextBlock Text="Phone *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditing}" Margin="0,0,0,10"/>

                    <TextBlock Text="City" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditing}" Margin="0,0,0,10"/>

                    <TextBlock Text="Address" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource FieldBox}" Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditing}" Margin="0,0,0,10"/>

                    <TextBlock Text="Status" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding Status}" IsEnabled="{Binding IsEditing}" Margin="0,0,0,10"/>

                    <TextBlock Text="Notes" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource FieldBox}" Height="72" TextWrapping="Wrap" AcceptsReturn="True"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditing}" Margin="0,0,0,14"/>

                    <Button Content="Cancel" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                            Command="{Binding CancelEditCommand}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
