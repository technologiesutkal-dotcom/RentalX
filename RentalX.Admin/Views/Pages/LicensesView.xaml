<UserControl x:Class="RentalX.Admin.Views.Pages.LicensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,8" Foreground="#64748B" FontSize="12" TextWrapping="Wrap"
                           Text="One license per client. Changing Trial → Monthly → Yearly updates the same license (no second row)."/>
                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding LoadCommand}"/>
                    <Button DockPanel.Dock="Right" Content="Change plan" Style="{StaticResource PrimaryButton}" Command="{Binding StartCreateCommand}"/>
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search key, client, plan, status"/>
                </DockPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Licenses}" SelectedItem="{Binding SelectedLicense}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="License key" Binding="{Binding LicenseKey}" Width="160"/>
                        <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="*"/>
                        <DataGridTextColumn Header="Plan" Binding="{Binding PlanType}" Width="90"/>
                        <DataGridTextColumn Header="Machines" Binding="{Binding ActiveMachineCount}" Width="70"/>
                        <DataGridTextColumn Header="Max" Binding="{Binding MaxMachines}" Width="50"/>
                        <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresAt, StringFormat=dd MMM yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Days" Binding="{Binding DaysRemaining}" Width="55"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SectionCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="License actions" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#0F766E" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Copy key" Style="{StaticResource PrimaryButton}" Command="{Binding CopyKeyCommand}" Margin="0,0,8,0"/>
                        <Button Content="Revoke" Style="{StaticResource DangerButton}" Command="{Binding RevokeCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Extend days" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#475569"/>
                        <TextBox Style="{StaticResource FieldBox}" Width="80" Text="{Binding ExtendDays, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Extend" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding ExtendCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="8,0,0,0"
                    Visibility="{Binding IsCreating, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Change plan (same license)" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="Updates the client's single license. Does not create a second key."
                               Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="Client *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Clients}"
                              SelectedItem="{Binding SelectedClient}" DisplayMemberPath="CompanyName" Margin="0,0,0,8"/>
                    <TextBlock Text="Plan *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding PlanOptions}"
                              SelectedItem="{Binding PlanType}" Margin="0,0,0,8"/>
                    <TextBlock Text="Max machines *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding MaxMachines, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Starts" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding StartsAt}" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Expires" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding ExpiresAt}" Height="40"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Notes" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save plan &amp; copy key" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelCreateCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
