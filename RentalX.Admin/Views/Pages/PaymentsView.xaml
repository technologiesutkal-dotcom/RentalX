<UserControl x:Class="RentalX.Admin.Views.Pages.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.35*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0,0,14,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding LoadCommand}"/>
                    <Button DockPanel.Dock="Right" Content="+ Record payment" Style="{StaticResource PrimaryButton}" Command="{Binding NewPaymentCommand}"/>
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding PaidAt, StringFormat=dd MMM yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="*"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=₹{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                        <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource SectionCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Payment form" FontSize="18" FontWeight="Bold"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Edit" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Command="{Binding EditSelectedCommand}"/>
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                                    IsEnabled="{Binding IsEditing}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#0F766E" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <TextBlock Text="Client *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Clients}"
                              SelectedItem="{Binding FormClient}" DisplayMemberPath="CompanyName"
                              IsEnabled="{Binding IsEditing}" Margin="0,0,0,8"/>

                    <TextBlock Text="License (optional)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding ClientLicenses}"
                              SelectedItem="{Binding FormLicense}" DisplayMemberPath="LicenseKey"
                              IsEnabled="{Binding IsEditing}" Margin="0,0,0,8"/>

                    <TextBlock Text="Amount *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditing}" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Currency" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsEditing}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Paid on" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding PaidAt}" Height="40" IsEnabled="{Binding IsEditing}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Method" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding MethodOptions}"
                              SelectedItem="{Binding Method}" IsEnabled="{Binding IsEditing}" Margin="0,0,0,8"/>

                    <TextBlock Text="Status" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding Status}" IsEnabled="{Binding IsEditing}" Margin="0,0,0,8"/>

                    <TextBlock Text="Reference" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditing}" Margin="0,0,0,8"/>

                    <TextBlock Text="Notes" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource FieldBox}" Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditing}" Margin="0,0,0,12"/>

                    <Button Content="Cancel" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                            Command="{Binding CancelEditCommand}"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
