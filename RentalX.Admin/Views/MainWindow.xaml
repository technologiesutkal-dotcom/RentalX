<Window x:Class="RentalX.Admin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RentalX Super Admin"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Semibold"
        MinWidth="1180" MinHeight="720">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#ECFDF5" Offset="0"/>
            <GradientStop Color="#F0FDFA" Offset="0.35"/>
            <GradientStop Color="#EFF6FF" Offset="0.7"/>
            <GradientStop Color="#F8FAFC" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Margin="14" CornerRadius="22" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.2,1">
                    <GradientStop Color="#042F2E" Offset="0"/>
                    <GradientStop Color="#0F766E" Offset="0.55"/>
                    <GradientStop Color="#115E59" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Transparent" Padding="16,14">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="{StaticResource AppLogoLight}"
                               Width="168" Height="44" Stretch="Uniform"
                               HorizontalAlignment="Center"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"
                               RenderOptions.BitmapScalingMode="Fant"/>
                        <TextBlock Text="Control Center" Foreground="#CCFBF1" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="PLATFORM" Foreground="#5EEAD4" FontSize="11" FontWeight="Bold" Margin="18,4,0,10" Opacity="0.85"/>
                        <ItemsControl ItemsSource="{Binding NavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavButtonStyle}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Key}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" Width="28" FontSize="14" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Margin="12" CornerRadius="16" Padding="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF18" Offset="0"/>
                            <GradientStop Color="#00000022" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="19">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#99F6E4" Offset="0"/>
                                        <GradientStop Color="#2DD4BF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="{Binding CurrentUserInitial}" Foreground="#042F2E" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUserName}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ApiStatus}" Foreground="#A7F3D0" FontSize="11" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ApiStatus}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Out" Style="{StaticResource GhostButton}"
                                Padding="12,8" FontSize="11" VerticalAlignment="Center"
                                Command="{Binding SignOutCommand}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="8,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="18" Padding="22,16" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F0FDFA" Offset="0.6"/>
                        <GradientStop Color="#ECFEFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.08" Color="#0F766E"/>
                </Border.Effect>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Requests · Clients · Licenses · Payments · Account — full platform control"
                                   Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="─" Width="38" Height="34" Margin="0,0,6,0" Background="#E2E8F0" BorderThickness="0" Click="Minimize_Click"/>
                        <Button Content="☐" Width="38" Height="34" Margin="0,0,6,0" Background="#E2E8F0" BorderThickness="0" Click="Maximize_Click"/>
                        <Button Content="✕" Width="38" Height="34" Background="#FEE2E2" Foreground="#B91C1C" BorderThickness="0" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>
        </Grid>
    </Grid>
</Window>
