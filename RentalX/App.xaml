<Application x:Class="RentalX.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RentalX.ViewModels"
             xmlns:pages="clr-namespace:RentalX.Views.Pages">
    <!-- WPF design-time: rebuild regenerates InitializeComponent in obj/*.g.cs -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/AppStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/RentalX.Admin;component/Themes/AdminResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ViewModel -> View mapping (MVVM navigation) -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <pages:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BookingsViewModel}">
                <pages:BookingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                <pages:InventoryView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DispatchViewModel}">
                <pages:DispatchView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReturnsViewModel}">
                <pages:ReturnsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BillingViewModel}">
                <pages:BillingView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PaymentsViewModel}">
                <pages:PaymentsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExpensesViewModel}">
                <pages:ExpensesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MaintenanceViewModel}">
                <pages:MaintenanceView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
                <pages:CustomersView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <pages:ReportsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <pages:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsersViewModel}">
                <pages:UsersView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
