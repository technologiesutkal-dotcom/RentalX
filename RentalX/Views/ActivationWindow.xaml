<Window x:Class="RentalX.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activate RentalX"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="560" Width="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#0B1220">

    <Border Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="160"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F766E" Offset="0"/>
                        <GradientStop Color="#115E59" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" Margin="36,0">
                    <Image Source="{StaticResource AppLogoLight}" Height="48" Stretch="Uniform"
                           HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Activate this machine with your license key"
                               Foreground="#99F6E4" FontSize="14" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="0" Padding="36">
                <StackPanel>
                    <TextBlock Text="License key" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                    <TextBox Height="44" Padding="12,10" FontSize="15" FontWeight="SemiBold"
                             Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="License API URL" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                    <TextBox Height="40" Padding="12,8"
                             Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Machine ID" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding MachineId}" FontFamily="Consolas" FontSize="12" Foreground="#0F172A" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding MachineName, StringFormat=Computer: {0}}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Copy ID" Padding="12,8" VerticalAlignment="Center"
                                Command="{Binding CopyMachineIdCommand}"/>
                    </Grid>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" MinHeight="20" Margin="0,8,0,4"/>
                    <TextBlock Text="{Binding InfoMessage}" Foreground="#0F766E" TextWrapping="Wrap" MinHeight="18" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Exit" Width="100" Height="40" Margin="0,0,10,0" Command="{Binding ExitCommand}"/>
                        <Button Content="Activate" Width="140" Height="40" Background="#0F766E" Foreground="White"
                                BorderThickness="0" FontWeight="SemiBold" Command="{Binding ActivateCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
