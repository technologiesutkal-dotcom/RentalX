<Window x:Class="RentalX.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:RentalX.Helpers"
        Title="RentalX Sign In"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#0B1220">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="LoginFieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LoginPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="1.15*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F766E" Offset="0"/>
                    <GradientStop Color="#115E59" Offset="0.55"/>
                    <GradientStop Color="#042F2E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="40">
                <StackPanel VerticalAlignment="Center">
                    <Image Source="{StaticResource AppLogoLight}" Height="64" Stretch="Uniform"
                           HorizontalAlignment="Left" Margin="0,0,0,18"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding WelcomeGreeting}"
                               Foreground="#99F6E4" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding WelcomeDate}"
                               Foreground="#5EEAD4" FontSize="12" Margin="0,0,0,22"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#CCFBF1" FontSize="13" LineHeight="22"
                               Text="Sign in with the login provided by Utkal Technologies. New installation? Use Apply for Access on the right."/>

                    <Border Background="#042F2E" CornerRadius="12" Padding="14" Margin="0,28,0,0" Opacity="0.92">
                        <StackPanel>
                            <TextBlock Text="TODAY'S TIP" Foreground="#F59E0B" FontSize="10" FontWeight="Bold"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding WelcomeTip}" Foreground="#FDE68A" FontSize="12"
                                       FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock VerticalAlignment="Bottom" Foreground="#5EEAD4" FontSize="11"
                           Text="Powered by Utkal Technologies"/>
            </Grid>
        </Border>

        <Border Grid.Column="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F8FAFC" Offset="0"/>
                    <GradientStop Color="#F0FDFA" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Button x:Name="CloseButton" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,14,16,0" Width="40" Height="40" FontSize="16" FontWeight="Bold"
                        Background="#FEE2E2" BorderThickness="0" Foreground="#B91C1C"
                        Cursor="Hand" Click="CloseButton_Click" Panel.ZIndex="20"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,50,0,20">
                    <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Background="White" CornerRadius="18" Padding="28"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="Sign in" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Enter your business login credentials"
                                       Foreground="#64748B" FontSize="12" Margin="0,4,0,18"/>

                            <TextBlock Text="Login ID" Foreground="#475569" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource LoginFieldStyle}"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                            <TextBlock Text="Password" Foreground="#475569" FontSize="11" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <PasswordBox helpers:PasswordBoxHelper.BindPassword="True"
                                             helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <PasswordBox.Style>
                                        <Style TargetType="PasswordBox" BasedOn="{StaticResource LoginPasswordStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </PasswordBox.Style>
                                </PasswordBox>
                                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource LoginFieldStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                            <CheckBox Content="Show password" IsChecked="{Binding ShowPassword}"
                                      Foreground="#64748B" FontSize="12" Margin="0,0,0,8"/>

                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{Binding ErrorBrush}"
                                       FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MinHeight="18"/>
                            <TextBlock Text="{Binding InfoMessage}" Foreground="#0F766E"
                                       FontSize="12" TextWrapping="Wrap" MinHeight="16" Margin="0,0,0,8"/>

                            <Button Content="Sign In" Height="42" FontSize="14" FontWeight="SemiBold"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding LoginCommand}" IsDefault="True"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Apply for Access" Padding="14,8" Background="#CCFBF1" BorderThickness="0"
                                        Foreground="#115E59" FontWeight="SemiBold"
                                        Command="{Binding ToggleApplyCommand}"/>
                            </StackPanel>

                            <Border Visibility="{Binding ShowApplyForm, Converter={StaticResource BoolToVis}}"
                                    Background="#F0FDFA" CornerRadius="12" Padding="14" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Apply for access" FontWeight="Bold" Foreground="#115E59" Margin="0,0,0,4"/>
                                    <TextBlock Text="Submit your details. Utkal Technologies will review and activate this computer."
                                               Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <TextBlock Text="Company *" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource LoginFieldStyle}" Text="{Binding ApplyCompany, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Email *" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource LoginFieldStyle}" Text="{Binding ApplyEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Phone *" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource LoginFieldStyle}" Text="{Binding ApplyPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Address *" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource LoginFieldStyle}" Text="{Binding ApplyAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Pincode *" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource LoginFieldStyle}" Text="{Binding ApplyPincode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Notes" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource LoginFieldStyle}" Text="{Binding ApplyNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                    <Button Content="Submit application" Style="{StaticResource PrimaryButtonStyle}" Height="40"
                                            Command="{Binding ApplyCommand}"/>
                                    <TextBlock Text="Need help? Contact Utkal Technologies."
                                               Foreground="#0F766E" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                                <TextBlock TextWrapping="Wrap" Foreground="#475569" FontSize="11" LineHeight="16"
                                           Text="New customer? Tap Apply for Access and submit your company details. For login ID, activation, or support — contact Utkal Technologies."/>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
