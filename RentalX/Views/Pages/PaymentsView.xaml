<UserControl x:Class="RentalX.Views.Pages.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <Border Background="#ECFDF5" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                <TextBlock Text="{Binding WorkflowHint}" TextWrapping="Wrap" Foreground="#1E3A8A" FontSize="13"/>
            </Border>

            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Collected Today" Foreground="#64748B"/>
                        <TextBlock Text="{Binding CollectedText}" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,8,0,0"/>
                        <TextBlock Text="Advance + balance + late" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Refunded Today" Foreground="#64748B"/>
                        <TextBlock Text="{Binding RefundedText}" FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,8,0,0"/>
                        <TextBlock Text="Early return refunds" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Net Today" Foreground="#64748B"/>
                        <TextBlock Text="{Binding NetTodayText}" FontSize="24" FontWeight="Bold" Foreground="#0F766E" Margin="0,8,0,0"/>
                        <TextBlock Text="Collected − Refunded" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Pending Balance" Foreground="#64748B"/>
                        <TextBlock Text="{Binding PendingText}" FontSize="24" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,0"/>
                        <TextBlock Text="Still due on bookings" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="20,16,20,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Balance due" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" Height="34" Padding="8,6" Margin="0,0,8,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Content="Clear" Style="{StaticResource QuickButtonStyle}"
                                Command="{Binding ClearSearchCommand}" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding ResultCountText}" Style="{StaticResource SecondaryTextStyle}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="4" Height="34" Padding="8,6" Margin="0,0,8,0"
                                 Text="{Binding CollectAmountText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="5" Content="Collect" Style="{StaticResource QuickButtonStyle}"
                                Command="{Binding CollectSelectedCommand}" Margin="0,0,8,0"/>
                        <Button Grid.Column="6" Content="Collect Full" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding CollectFullBalanceCommand}"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding FormMessage}" Foreground="{Binding FormMessageBrush}"
                               FontWeight="SemiBold" Margin="20,0,20,10" TextWrapping="Wrap"/>
                    <DataGrid Grid.Row="3" Style="{StaticResource DashboardDataGridStyle}"
                              ItemsSource="{Binding UnpaidBookings}"
                              SelectedItem="{Binding SelectedUnpaidBooking}"
                              MinHeight="160" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Booking" Binding="{Binding BookingNumber}" Width="110"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding AmountText}" Width="90"/>
                            <DataGridTextColumn Header="Paid" Binding="{Binding PaidText}" Width="90"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding BalanceText}" Width="90"/>
                            <DataGridTextColumn Header="Money" Binding="{Binding PaymentStatusText}" Width="110"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Payment History (advance + balance)" Style="{StaticResource SectionTitleStyle}" Margin="20,0"/>
                    <DataGrid Grid.Row="1" Style="{StaticResource DashboardDataGridStyle}" ItemsSource="{Binding Payments}"
                              MinHeight="200" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="120"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate, StringFormat=dd MMM yyyy}" Width="140"/>
                            <DataGridCheckBoxColumn Header="Advance" Binding="{Binding IsDeposit}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
