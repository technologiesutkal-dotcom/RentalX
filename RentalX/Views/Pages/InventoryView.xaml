<UserControl x:Class="RentalX.Views.Pages.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="6" Text="Add Inventory Item" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="1" Margin="0,0,8,0">
                        <TextBlock Text="Item Name *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6"/>
                        <TextBlock Text="{Binding NameError}" Foreground="#DC2626" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Category *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategory}" Height="36" VerticalContentAlignment="Center"/>
                        <TextBlock Text="{Binding CategoryError}" Foreground="#DC2626" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Quantity *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6"/>
                        <TextBlock Text="{Binding QuantityError}" Foreground="#DC2626" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Daily Rate *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewDailyRate, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6"/>
                        <TextBlock Text="{Binding RateError}" Foreground="#DC2626" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Row="1" Grid.Column="4" Content="Add Item" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddItemCommand}" VerticalAlignment="Top" Margin="0,18,8,0"/>
                    <StackPanel Grid.Row="1" Grid.Column="5" VerticalAlignment="Top" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="80" Height="36" Padding="8,6" Text="{Binding AddStockQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <Button Content="Add Stock" Style="{StaticResource QuickButtonStyle}" Command="{Binding AddStockCommand}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AddStockError}" Foreground="#DC2626" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="6" Text="{Binding FormMessage}" Foreground="{Binding FormMessageBrush}"
                               FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Edit Selected Item (all fields)" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>

                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,4">
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Name *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Category *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding EditCategory}" Height="36" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Total Qty *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditTotalQuantity, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Daily Rate / Price *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditDailyRate, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Status *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding EditStatus}" Height="36" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Save All Changes" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveSelectedItemCommand}" Margin="0,0,8,0"/>
                        <Button Content="Delete Item" Style="{StaticResource QuickButtonStyle}"
                                Command="{Binding DeleteSelectedItemCommand}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding EditError}" Foreground="#DC2626" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="20,16,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Inventory Stock" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBox Grid.Column="1" Height="34" Padding="8,6" Margin="0,0,8,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search name, category, status, rate..."/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding FilterCategories}" SelectedItem="{Binding FilterCategory}"
                                  Height="34" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding FilterStatuses}" SelectedItem="{Binding FilterStatus}"
                                  Height="34" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="4" Content="Clear" Style="{StaticResource QuickButtonStyle}"
                                Command="{Binding ClearSearchCommand}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="5" Text="{Binding ResultCountText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid Grid.Row="1" Style="{StaticResource DashboardDataGridStyle}"
                              ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                              MinHeight="240" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalQuantity}" Width="70"/>
                            <DataGridTextColumn Header="Rented" Binding="{Binding RentedQuantity}" Width="70"/>
                            <DataGridTextColumn Header="Available" Binding="{Binding AvailableQuantity}" Width="90"/>
                            <DataGridTextColumn Header="Daily Rate" Binding="{Binding DailyRate, StringFormat=₹{0:N0}}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
