<UserControl x:Class="RentalX.Views.Pages.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="20,16,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Invoices / Billing" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBox Grid.Column="1" Height="34" Padding="8,6" Margin="0,0,8,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="Clear" Style="{StaticResource QuickButtonStyle}"
                            Command="{Binding ClearSearchCommand}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding ResultCountText}" Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Grid.Column="4" Content="Generate Invoice PDF" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding GenerateInvoiceCommand}"/>
                </Grid>
                <TextBlock Grid.Row="1" Margin="20,0,20,10"
                           Text="{Binding FormMessage}" Foreground="{Binding FormMessageBrush}" FontWeight="SemiBold"/>
                <DataGrid Grid.Row="2" Style="{StaticResource DashboardDataGridStyle}"
                          ItemsSource="{Binding Invoices}"
                          SelectedItem="{Binding SelectedBooking}"
                          Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Booking" Binding="{Binding BookingNumber}" Width="110"/>
                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceText}" Width="110"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="Items" Binding="{Binding ItemsSummary}" Width="160"/>
                        <DataGridTextColumn Header="Rate" Binding="{Binding DailyRate, StringFormat=₹{0:N0}}" Width="90"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="100"/>
                        <DataGridTextColumn Header="Paid" Binding="{Binding PaidText}" Width="90"/>
                        <DataGridTextColumn Header="Balance" Binding="{Binding BalanceText}" Width="90"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
