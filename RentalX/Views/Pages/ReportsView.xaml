<UserControl x:Class="RentalX.Views.Pages.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="From" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,10,0"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Height="36" VerticalContentAlignment="Center">
                    <DatePicker.Resources>
                        <Style TargetType="DatePickerTextBox">
                            <Setter Property="IsReadOnly" Value="True"/>
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>

                <TextBlock Grid.Column="2" Text="To" VerticalAlignment="Center" Foreground="#64748B" Margin="16,0,10,0"/>
                <DatePicker Grid.Column="3" SelectedDate="{Binding ToDate}" Height="36" VerticalContentAlignment="Center">
                    <DatePicker.Resources>
                        <Style TargetType="DatePickerTextBox">
                            <Setter Property="IsReadOnly" Value="True"/>
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>

                <Button Grid.Column="4" Content="Generate Report" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding GenerateReportCommand}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <Button Grid.Column="5" Content="Export PDF" Style="{StaticResource QuickButtonStyle}"
                        Command="{Binding ExportPdfCommand}" Margin="10,0,0,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CompanyHeaderText}" FontWeight="SemiBold" Foreground="#0F766E"/>
                    <TextBlock Text="{Binding ReportPeriodText}" Style="{StaticResource SecondaryTextStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Style="{StaticResource SecondaryTextStyle}"
                   Margin="4,0,4,12" TextWrapping="Wrap"/>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="Collected" Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="{Binding CollectedText}" FontSize="22" FontWeight="Bold" Foreground="#059669" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="4,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="Expenses" Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="{Binding ExpensesText}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="4,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="Profit" Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="{Binding ProfitText}" FontSize="22" FontWeight="Bold" Foreground="#0F766E" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="Balance" Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="{Binding BalanceText}" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Bookings" Style="{StaticResource SectionTitleStyle}" Margin="16,0"
                               VerticalAlignment="Center"/>
                    <DataGrid Grid.Row="1" Style="{StaticResource DashboardDataGridStyle}"
                              ItemsSource="{Binding ReportRows}" SelectedItem="{Binding SelectedRow}" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Booking" Binding="{Binding BookingNumber}" Width="100"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding BookingDateText}" Width="100"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Expenses in Range" Style="{StaticResource SectionTitleStyle}" Margin="16,0"/>
                    <DataGrid Grid.Row="1" Style="{StaticResource DashboardDataGridStyle}"
                              ItemsSource="{Binding ExpenseRows}" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding ExpenseDateText}" Width="90"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
