<UserControl x:Class="RentalX.Views.Pages.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <Border Background="#ECFDF5" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                <TextBlock Text="{Binding WorkflowHint}" TextWrapping="Wrap" Foreground="#1E3A8A" FontSize="13"/>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Settlement at Receive" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Actual return date" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding ActualReturnDate}" Height="36">
                                <DatePicker.Resources>
                                    <Style TargetType="DatePickerTextBox">
                                        <Setter Property="IsReadOnly" Value="True"/>
                                    </Style>
                                </DatePicker.Resources>
                            </DatePicker>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Manual adjust ₹ (+ late / - discount)" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ManualAdjustmentText, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8" VerticalAlignment="Bottom">
                            <CheckBox Content="Early return credit (auto)" IsChecked="{Binding ApplyEarlyCredit}" Margin="0,0,0,8"/>
                            <CheckBox Content="Settle money now" IsChecked="{Binding CollectPayment}" Margin="0,0,0,8"/>
                            <CheckBox Content="Generate invoice PDF" IsChecked="{Binding GenerateInvoice}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Note (optional)" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SettlementNote, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6"/>
                        </StackPanel>
                    </UniformGrid>

                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding SettlementHint}" Foreground="#1E3A8A" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Type" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Text="{Binding Settlement.TypeLabel, TargetNullValue=-}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Original" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Text="{Binding Settlement.OriginalAmountText, TargetNullValue=-}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Auto adjust" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Text="{Binding Settlement.AutoAdjustmentText, TargetNullValue=-}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Final amount" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Text="{Binding Settlement.FinalAmountText, TargetNullValue=-}" FontWeight="Bold" Foreground="#0F766E"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Collect / Refund" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Text="{Binding CollectRefundText}" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding Settlement.Summary}" Foreground="#64748B" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button Content="Receive &amp; Settle" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ReceiveSelectedCommand}" Margin="0,0,8,0"/>
                        <Button Content="Reset" Style="{StaticResource QuickButtonStyle}"
                                Command="{Binding ResetManualCommand}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding FormMessage}" Foreground="{Binding FormMessageBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="20,16,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Out with customer" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" Height="34" Padding="8,6" Margin="0,0,8,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Content="Clear" Style="{StaticResource QuickButtonStyle}"
                                Command="{Binding ClearSearchCommand}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding ResultCountText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                    </Grid>
                    <DataGrid Grid.Row="1" Style="{StaticResource DashboardDataGridStyle}"
                              ItemsSource="{Binding PendingReturns}"
                              SelectedItem="{Binding SelectedBooking}"
                              MinHeight="220" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Booking" Binding="{Binding BookingNumber}" Width="100"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Items" Binding="{Binding ItemsSummary}" Width="140"/>
                            <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedReturnText}" Width="110"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding AmountText}" Width="90"/>
                            <DataGridTextColumn Header="Paid" Binding="{Binding PaidText}" Width="90"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding BalanceText}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
