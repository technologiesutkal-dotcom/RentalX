<UserControl x:Class="RentalX.Views.Pages.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.ColumnSpan="6" Text="Add Expense" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Margin="0,0,8,0">
                    <TextBlock Text="Title *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6"/>
                    <TextBlock Text="{Binding TitleError}" Foreground="#DC2626" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Category *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategory}" Height="36" VerticalContentAlignment="Center"/>
                    <TextBlock Text="{Binding CategoryError}" Foreground="#DC2626" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Amount *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6"/>
                    <TextBlock Text="{Binding AmountError}" Foreground="#DC2626" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Date *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding ExpenseDate}" Height="36" VerticalContentAlignment="Center">
                        <DatePicker.Resources>
                            <Style TargetType="DatePickerTextBox">
                                <Setter Property="IsReadOnly" Value="True"/>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>
                    <TextBlock Text="{Binding DateError}" Foreground="#DC2626" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,8,0">
                    <TextBlock Text="Notes" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6"/>
                </StackPanel>
                <Button Grid.Row="1" Grid.Column="5" Content="Add Expense" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddExpenseCommand}" VerticalAlignment="Top" Margin="0,18,0,0"/>

                <TextBlock Grid.Row="2" Grid.ColumnSpan="6" Text="{Binding FormMessage}" Foreground="{Binding FormMessageBrush}"
                           FontWeight="SemiBold" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="20,16,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Expense List" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" Height="34" Padding="8,6" Margin="0,0,8,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding FilterCategories}" SelectedItem="{Binding FilterCategory}"
                              Height="34" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="3" Content="Clear" Style="{StaticResource QuickButtonStyle}"
                            Command="{Binding ClearSearchCommand}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="4" Text="{Binding ResultCountText}" Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="5" Text="{Binding TotalText, StringFormat=Total: {0}}" Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center"/>
                </Grid>
                <DataGrid Grid.Row="1" Style="{StaticResource DashboardDataGridStyle}"
                          ItemsSource="{Binding Expenses}" SelectedItem="{Binding SelectedExpense}" Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding ExpenseDateText}" Width="120"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="110"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="220"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
