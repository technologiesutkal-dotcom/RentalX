<UserControl x:Class="RentalX.Views.Pages.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.ColumnSpan="6"
                           Text="Add Organization Staff"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,14"/>

                <StackPanel Grid.Row="1" Margin="0,0,10,0">
                    <TextBlock Text="Full Name *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6"/>
                    <TextBlock Text="{Binding NameError}" Foreground="#DC2626" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Phone *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6"/>
                    <TextBlock Text="{Binding PhoneError}" Foreground="#DC2626" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Email (optional)" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6"/>
                    <TextBlock Text="{Binding EmailError}" Foreground="#DC2626" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="Role *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableRoles}"
                              SelectedItem="{Binding SelectedRole}"
                              Height="36"
                              VerticalContentAlignment="Center"/>
                    <TextBlock Text="{Binding RoleError}" Foreground="#DC2626" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="Department *" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableDepartments}"
                              SelectedItem="{Binding SelectedDepartment}"
                              Height="36"
                              VerticalContentAlignment="Center"/>
                    <TextBlock Text="{Binding DepartmentError}" Foreground="#DC2626" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,18,0,0">
                    <Button Content="Add Staff"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddStaffCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Add Myself"
                            Style="{StaticResource QuickButtonStyle}"
                            Command="{Binding AddMyselfCommand}"
                            Margin="0"/>
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Grid.ColumnSpan="6"
                           Text="{Binding FormMessage}"
                           Foreground="{Binding FormMessageBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="20,16,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Staff Directory" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" Height="34" Padding="8,6" Margin="0,0,8,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="Clear" Style="{StaticResource QuickButtonStyle}"
                            Command="{Binding ClearSearchCommand}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding ResultCountText}" Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Grid.Column="4" Content="Toggle Active / Inactive"
                            Style="{StaticResource LinkButtonStyle}"
                            Command="{Binding ToggleActiveCommand}"/>
                </Grid>
                <DataGrid Grid.Row="1"
                          Style="{StaticResource DashboardDataGridStyle}"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedStaff}"
                          Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="140"/>
                        <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="130"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
