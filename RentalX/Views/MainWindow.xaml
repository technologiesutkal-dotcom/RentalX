<Window x:Class="RentalX.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RentalX - Rental Management System"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F3F6FB" Offset="0"/>
            <GradientStop Color="#E7EEF8" Offset="0.55"/>
            <GradientStop Color="#F6F3FB" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradient}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="96"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="78"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Transparent" Padding="16,14">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="{StaticResource AppLogoLight}"
                               Width="168" Height="44" Stretch="Uniform"
                               HorizontalAlignment="Center"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"
                               RenderOptions.BitmapScalingMode="Fant"/>
                        <TextBlock Text="Rental Management"
                                   Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Opacity="1"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="MAIN" Foreground="#7C8DA6" FontSize="11" FontWeight="Bold" Margin="26,12,0,8"/>
                        <ItemsControl ItemsSource="{Binding MainNavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavButtonStyle}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Key}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" Style="{StaticResource IconGlyphStyle}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="BUSINESS" Foreground="#7C8DA6" FontSize="11" FontWeight="Bold" Margin="26,22,0,8"/>
                        <ItemsControl ItemsSource="{Binding BusinessNavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavButtonStyle}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Key}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" Style="{StaticResource IconGlyphStyle}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="SYSTEM" Foreground="#7C8DA6" FontSize="11" FontWeight="Bold" Margin="26,22,0,8"/>
                        <ItemsControl ItemsSource="{Binding SystemNavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavButtonStyle}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Key}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" Style="{StaticResource IconGlyphStyle}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="{StaticResource SidebarFooterGradient}" Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource BrandGradient}">
                                <TextBlock Text="{Binding CurrentUserInitial}"
                                           Foreground="White" FontWeight="Bold" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUserName}" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding CurrentUserRole}" Foreground="#93A4BD" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Sign out" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Foreground="#99F6E4"
                                Cursor="Hand" FontSize="11" Padding="8,4"
                                Command="{Binding LogoutCommand}" ToolTip="Sign out"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3"/>
                <RowDefinition Height="78"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BrandGradient}"/>

            <Border Grid.Row="1"
                    Background="{StaticResource HeaderGradient}"
                    BorderBrush="#E6EDF5"
                    BorderThickness="0,0,0,1"
                    ClipToBounds="False"
                    Panel.ZIndex="20">
                <Grid Margin="28,0" ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="False">
                        <!-- Search: fixed height so dropdown never stretches header / New Booking -->
                        <Grid Width="300" Height="40" Margin="0,0,12,0" ClipToBounds="False">
                            <Border x:Name="SearchFieldBorder" Height="40" CornerRadius="10"
                                    Background="{StaticResource SearchGradient}"
                                    BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid Margin="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="#64748B" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1" Margin="6,0,0,0">
                                        <TextBox x:Name="SearchBox"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" FontSize="13" Foreground="#0F172A"/>
                                        <TextBlock Text="Search bookings, customers, items..."
                                                   Foreground="#94A3B8" FontSize="13"
                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Popup IsOpen="{Binding IsSearchOpen, Mode=OneWay}"
                                   PlacementTarget="{Binding ElementName=SearchFieldBorder}"
                                   Placement="Bottom"
                                   StaysOpen="True"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   HorizontalOffset="0"
                                   VerticalOffset="6">
                                <Border Width="300" MaxHeight="280"
                                        Background="White"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Effect="{StaticResource CardShadow}">
                                    <ListBox ItemsSource="{Binding SearchResults}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent" BorderThickness="0"
                                                        HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                        Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Margin="12,8">
                                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>

                        <Grid x:Name="NotificationHost" Width="44" Height="44" Margin="0,0,10,0" ClipToBounds="False">
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Width="40" Height="40"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Command="{Binding ToggleNotificationsCommand}">
                                <TextBlock Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Border Width="18" Height="18" CornerRadius="9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,0,0,0" Panel.ZIndex="2"
                                    Background="{StaticResource DangerGradient}" IsHitTestVisible="False"
                                    Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding NotificationCount}" Foreground="White" FontSize="10"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Popup IsOpen="{Binding IsNotificationsOpen, Mode=OneWay}"
                                   PlacementTarget="{Binding ElementName=NotificationHost}"
                                   Placement="Bottom"
                                   StaysOpen="True"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   HorizontalOffset="-256"
                                   VerticalOffset="6">
                                <Border Width="300" MaxHeight="300"
                                        Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="12" Effect="{StaticResource CardShadow}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Notifications}" Margin="10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                            <TextBlock Text="{Binding Message}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                            <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Height="40" MinWidth="140" MaxHeight="40"
                                Margin="0,0,12,0" Padding="0"
                                VerticalAlignment="Center"
                                Command="{Binding NewBookingCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="New Booking" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Width="40"
                                Height="40"
                                Cursor="Hand"
                                ToolTip="Close application"
                                Command="{Binding CloseApplicationCommand}"
                                FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="10">
                                        <TextBlock x:Name="Icon"
                                                   Text="&#xE8BB;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="#64748B"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerSoftGradient}"/>
                                            <Setter TargetName="Icon" Property="Foreground" Value="#DC2626"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ContentControl Content="{Binding CurrentViewModel}" Margin="0"/>

                <!-- Loading overlay when switching tabs -->
                <Border Background="#99F3F6FB"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="160"
                            Height="160"
                            CornerRadius="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{StaticResource CardGradient}"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid Width="56" Height="56" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate"/>
                                </Grid.RenderTransform>
                                <Ellipse Width="56" Height="56"
                                         StrokeThickness="5"
                                         StrokeDashArray="3 1.5">
                                    <Ellipse.Stroke>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0F766E" Offset="0"/>
                                            <GradientStop Color="#004D40" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Stroke>
                                </Ellipse>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360"
                                                                 Duration="0:0:0.9"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                            </Grid>
                            <TextBlock Text="{Binding LoadingMessage}"
                                       Margin="0,16,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
