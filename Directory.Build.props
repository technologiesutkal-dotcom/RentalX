<Project>
  <!--
    WPF SDK projects: prevent parallel markup/C# races that cause
    BG1002 (missing .baml), CS0103 (InitializeComponent), CS2001 (missing .g.cs).
  -->
  <PropertyGroup>
    <BuildInParallel>false</BuildInParallel>
    <Prefer32Bit>false</Prefer32Bit>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseWPF)' == 'true'">
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!-- Keep markup compile deterministic for VS + CLI -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <GenerateTemporaryTargetAssembly>true</GenerateTemporaryTargetAssembly>
  </PropertyGroup>
</Project>
